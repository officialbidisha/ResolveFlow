GITHUB_TOKEN=
OPENAI_API_KEY=
PINECONE_API_KEY=

# app/main.py's checkpointer — a real Postgres instance (Neon/Supabase/Render
# Postgres all work), not local sqlite, so paused interrupt() runs survive
# container recycling on Render's free tier. Needs psycopg's async driver
# scheme: postgresql://user:pass@host:port/dbname. Also backs app/db.py's
# OAuth session/rate-limit/thread-ownership tables (same instance, separate
# connection pool from the checkpointer).
DATABASE_URL=

# "Sign in with GitHub" — create an OAuth App at
# github.com/settings/developers with callback URL
# <your deployed backend>/api/auth/github/callback, then fill these in from it.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# The deployed frontend origin (e.g. https://your-app.vercel.app, or
# http://localhost:5173 for local dev). Used for CORS and the post-login
# redirect. NOTE: the session cookie is SameSite=None+Secure (see
# app/main.py's module docstring), so the full OAuth round trip only works
# over HTTPS — plain http://localhost can log in but the session cookie
# won't stick.
FRONTEND_URL=

# optional — flip on LangSmith tracing for near-zero effort, high resume payoff
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=resolveflow
